# Environment configuration for projects/ai_agents
# Copy this file to .env in the repo root (or export the variables in your shell)
# DO NOT commit your real .env file.

# Required by every agent in this module.
# Get a key at https://console.anthropic.com/
ANTHROPIC_API_KEY=your_claude_api_key_here

# Optional overrides (each agent falls back to sensible defaults if unset).
AI_AGENTS_MODEL=claude-sonnet-5
AI_AGENTS_MAX_TOKENS=1024
LOG_LEVEL=INFO

# Agent 4 (memory_rag) only: where the local JSON "vector store" is persisted.
AI_AGENTS_MEMORY_PATH=./projects/ai_agents/agent4_memory_rag/memory_store.json
